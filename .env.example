# Sao chép file này thành `.env` trước khi chạy dự án:  cp .env.example .env

# CSDL SQLite — đường dẫn tính từ thư mục gốc dự án
DATABASE_URL="file:./prisma/dev.db"

# Khoá ký cookie phiên đăng nhập. ĐỔI thành chuỗi ngẫu nhiên dài khi triển khai thật.
AUTH_SECRET="doan-halona-dev-secret-doi-truoc-khi-deploy"

# Địa chỉ gốc dùng cho sitemap và thẻ metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
