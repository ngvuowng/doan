# Cổng 3307 vì cổng 3306 trên máy dev đã có MySQL khác chiếm (xem docker-compose.yml).
DATABASE_URL=mysql+pymysql://halona:halona@127.0.0.1:3307/halona?charset=utf8mb4

# Khoá ký JWT. BẮT BUỘC đổi trước khi triển khai thật.
AUTH_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# Nguồn được phép gọi API, phân cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000

# ---------- Trợ lý ảo Gemini ----------
# Lấy khoá tại https://aistudio.google.com/apikey rồi dán vào backend/.env
# (.env đã nằm trong .gitignore, KHÔNG commit khoá lên git).
# Để trống thì website vẫn chạy bình thường, chỉ khung chat báo lỗi 503 tiếng Việt.
GEMINI_API_KEY=

# Model dùng để trả lời. gemini-2.5-flash nhanh, rẻ và có hạn mức miễn phí.
GEMINI_MODEL=gemini-2.5-flash

# Thời gian chờ tối đa cho một lượt gọi Gemini (giây).
GEMINI_TIMEOUT_SECONDS=25

# Số câu hỏi tối đa một phiên chat được gửi trong 10 phút — chặn spam và chặn tốn tiền.
GEMINI_RATE_LIMIT=20

# Đặt =1 để thử toàn bộ luồng chat (lưu CSDL, lịch sử, giao diện) khi chưa có khoá thật.
# GEMINI_MOCK=1
