# Cổng 3307 vì cổng 3306 trên máy dev đã có MySQL khác chiếm (xem docker-compose.yml).
DATABASE_URL=mysql+pymysql://halona:halona@127.0.0.1:3307/halona?charset=utf8mb4

# Khoá ký JWT. BẮT BUỘC đổi trước khi triển khai thật.
AUTH_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# Nguồn được phép gọi API, phân cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000
