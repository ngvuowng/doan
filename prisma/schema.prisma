// Lược đồ CSDL cho bản clone nongsan.maugiaodien.com (Halona Fruist)
// SQLite: chạy được ngay sau `npm install`, không cần dựng server CSDL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Dùng chung cho danh mục sản phẩm và chuyên mục bài viết, phân biệt bằng `kind`.
/// (SQLite không hỗ trợ enum của Prisma nên dùng String.)
model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  kind     String // "product" | "post"
  subtitle String? // phụ đề hiển thị dưới tiêu đề section ở trang chủ
  position Int       @default(0)
  products Product[] @relation("ProductCategories")
  posts    Post[]    @relation("PostCategories")

  @@index([kind])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Giá niêm yết, đơn vị VND (đồng).
  price       Int
  /// Giá khuyến mãi; null nghĩa là không giảm giá.
  salePrice   Int?
  image       String
  /// Ảnh thứ hai hiện khi rê chuột lên card sản phẩm (theo bản gốc).
  hoverImage  String?
  shortDescription String
  description String
  stock       Int     @default(100)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  categories Category[]  @relation("ProductCategories")
  orderItems OrderItem[]
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  /// Nội dung HTML lấy nguyên từ RSS feed của site gốc.
  content     String
  image       String
  publishedAt DateTime
  categories  Category[] @relation("PostCategories")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("USER") // "USER" | "ADMIN"
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Order {
  id     String  @id @default(cuid())
  /// Mã đơn hiển thị cho khách, vd. "HL-8F3K2A".
  code   String  @unique
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  email         String
  phone         String
  address       String
  note          String?
  paymentMethod String @default("COD")
  /// PENDING | CONFIRMED | SHIPPING | COMPLETED | CANCELLED
  status        String @default("PENDING")
  /// Tổng tiền chốt tại thời điểm đặt, đơn vị VND.
  total         Int

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([userId])
  @@index([status])
}

/// Lưu ảnh chụp tên/giá tại thời điểm đặt hàng, để đơn cũ không đổi khi sản phẩm đổi giá.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name     String
  price    Int
  quantity Int
  image    String

  @@index([orderId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
